:host {
  display: block;
  --azul: #04101f;
  --dorado: #d4af37;
  --marfil: #f5f0e6;
  --texto: #263244;
  --borde: #e1d8c7;
}

* {
  box-sizing: border-box;
}

.leccion-page {
  min-height: 100vh;
  background: var(--marfil);
  color: var(--texto);
  font-family: inherit;
  line-height: 1.7;
}

.leccion-header {
  background: var(--azul);
  color: var(--marfil);
  padding: 30px 22px 54px;
  text-align: center;
}

.marca {
  display: inline-block;
  color: var(--dorado);
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-decoration: none;
}

.volver {
  display: block;
  width: fit-content;
  margin: 18px auto 30px;
  color: var(--marfil);
  text-decoration: none;
  font-size: 0.92rem;
}

.volver:hover,
.enlace-final:hover {
  color: var(--dorado);
}

.etiqueta {
  color: var(--dorado);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  margin: 0 0 12px;
}

.leccion-header h1 {
  max-width: 850px;
  margin: 0 auto;
  font-size: clamp(2rem, 5vw, 3.5rem);
  line-height: 1.15;
  letter-spacing: 0.035em;
}

.subtitulo {
  max-width: 680px;
  margin: 20px auto;
  font-size: 1.12rem;
}

.linea-dorada {
  width: 76px;
  height: 3px;
  margin: 26px auto;
  background: var(--dorado);
}

.introduccion {
  max-width: 760px;
  margin: 0 auto;
  color: #e5e1d8;
  font-size: 1.02rem;
}

.valores {
  color: var(--dorado);
  font-weight: 700;
  letter-spacing: 0.045em;
  margin-top: 24px;
}

main {
  width: min(100% - 32px, 900px);
  margin: 0 auto;
  padding: 38px 0 64px;
}

.idea-central {
  padding: 30px;
  background: #fffdf8;
  border: 1px solid var(--borde);
  border-top: 4px solid var(--dorado);
  border-radius: 12px;
  margin-bottom: 38px;
}

.idea-central h2,
.reflexion h2,
.cierre h2 {
  color: var(--azul);
  line-height: 1.35;
}

.idea-central h2 {
  margin: 8px 0 14px;
  font-size: clamp(1.45rem, 3vw, 2rem);
}

.idea-central p:last-child {
  margin-bottom: 0;
}

.contenido {
  display: grid;
  gap: 18px;
  margin-bottom: 48px;
}

.leccion-bloque {
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr);
  gap: 18px;
  padding: 25px 22px;
  background: #fffdf8;
  border: 1px solid var(--borde);
  border-radius: 10px;
}

.numero {
  color: var(--dorado);
  font-size: 1.7rem;
  font-weight: 800;
  line-height: 1.3;
}

.leccion-bloque h2 {
  margin: 0 0 10px;
  color: var(--azul);
  font-size: 1.28rem;
  line-height: 1.4;
}

.leccion-bloque p {
  margin: 0 0 12px;
}

.leccion-bloque p:last-child {
  margin-bottom: 0;
}

.reflexion {
  padding: clamp(22px, 5vw, 42px);
  background: #fffdf8;
  border: 1px solid var(--borde);
  border-radius: 14px;
  box-shadow: 0 8px 28px rgb(4 16 31 / 6%);
}

.reflexion h2 {
  margin: 0 0 12px;
  font-size: clamp(1.65rem, 4vw, 2.3rem);
}

.reflexion-intro {
  margin: 0 0 30px;
}

.pregunta {
  padding: 25px 0;
  border-top: 1px solid var(--borde);
}

.pregunta > label:first-child {
  display: block;
  margin-bottom: 16px;
  color: var(--azul);
  font-weight: 750;
  font-size: 1.06rem;
}

.opciones {
  display: grid;
  gap: 10px;
  margin-bottom: 16px;
}

.opcion {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  background: #f8f5ed;
  border: 1px solid var(--borde);
  border-radius: 8px;
  cursor: pointer;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.opcion:hover {
  border-color: var(--dorado);
}

.opcion input {
  flex: 0 0 auto;
  margin-top: 6px;
  accent-color: var(--azul);
}

.pregunta textarea {
  display: block;
  width: 100%;
  min-height: 86px;
  margin-top: 12px;
  padding: 13px 14px;
  border: 1px solid #cfc6b5;
  border-radius: 8px;
  background: #fff;
  color: var(--azul);
  font: inherit;
  resize: vertical;
}

.pregunta textarea:focus {
  outline: 2px solid var(--dorado);
  outline-offset: 2px;
}

.boton-guardar {
  display: block;
  width: 100%;
  padding: 16px 20px;
  margin-top: 12px;
  border: 2px solid var(--dorado);
  border-radius: 8px;
  background: var(--azul);
  color: var(--marfil);
  font: inherit;
  font-weight: 800;
  letter-spacing: 0.035em;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease;
}

.boton-guardar:hover {
  background: var(--dorado);
  color: var(--azul);
}

.mensaje-guardado {
  color: #24543b;
  font-weight: 700;
  text-align: center;
}

.nota-privacidad {
  margin: 18px 0 0;
  color: #626b76;
  font-size: 0.88rem;
  text-align: center;
}

.cierre {
  padding: 46px 16px 0;
  text-align: center;
}

.cierre > p:first-child {
  color: #5c6470;
}

.cierre h2 {
  max-width: 680px;
  margin: 12px auto;
  font-size: clamp(1.5rem, 4vw, 2.2rem);
}

.lema {
  color: var(--azul);
  font-size: 1.2rem;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.enlace-final {
  display: inline-block;
  margin-top: 18px;
  color: var(--azul);
  font-weight: 800;
  text-decoration: none;
}

@media (max-width: 600px) {
  .leccion-header {
    padding: 25px 18px 38px;
  }

  main {
    width: min(100% - 22px, 900px);
    padding-top: 22px;
  }

  .idea-central {
    padding: 22px 18px;
  }

  .leccion-bloque {
    grid-template-columns: 38px minmax(0, 1fr);
    gap: 12px;
    padding: 20px 15px;
  }

  .numero {
    font-size: 1.35rem;
  }

  .reflexion {
    padding: 23px 16px;
  }

  .opcion {
    padding: 12px;
  }

  .boton-guardar {
    font-size: 0.92rem;
  }
}
