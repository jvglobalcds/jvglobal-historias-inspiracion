import { Component } from '@angular/core';
import { RouterLink } from '@angular/router';
import { FormsModule } from '@angular/forms';

interface EjercicioLiderazgo {
  id: string;
  numero: string;
  titulo: string;
  enfoque: string;
  pregunta: string;
  accion: string;
  cuando: string;
  aprendizaje: string;
  contribucion: string;
}

@Component({
  selector: 'app-practica-liderazgo-cds',
  standalone: true,
  imports: [RouterLink, FormsModule],
  templateUrl: './practica-liderazgo-cds.html',
  styleUrl: './practica-liderazgo-cds.css'
})
export class PracticaLiderazgoCds {
  private readonly claveGuardado = 'cds_practica_liderazgo';

  guardado = false;
  mensaje = '';

  ejercicios: EjercicioLiderazgo[] = [
    {
      id: 'aplicar',
      numero: '01',
      titulo: 'APLICAR',
      enfoque: 'Convertir el aprendizaje en una acción personal.',
      pregunta: '¿Qué enseñanza necesito llevar a la práctica en mi vida?',
      accion: '',
      cuando: '',
      aprendizaje: '',
      contribucion: ''
    },
    {
      id: 'acompanar',
      numero: '02',
      titulo: 'ACOMPAÑAR',
      enfoque: 'Escuchar y ayudar sin imponer nuestras respuestas.',
      pregunta: '¿A quién puedo escuchar y ayudar a encontrar su siguiente paso?',
      accion: '',
      cuando: '',
      aprendizaje: '',
      contribucion: ''
    },
    {
      id: 'contribuir',
      numero: '03',
      titulo: 'CONTRIBUIR',
      enfoque: 'Poner nuestras capacidades al servicio de otras personas.',
      pregunta: '¿Qué puedo aportar para fortalecer a mi comunidad?',
      accion: '',
      cuando: '',
      aprendizaje: '',
      contribucion: ''
    },
    {
      id: 'formar',
      numero: '04',
      titulo: 'FORMAR',
      enfoque: 'Compartir lo aprendido para desarrollar autonomía en otros.',
      pregunta: '¿Qué puedo enseñar y cómo acompañaré su aplicación?',
      accion: '',
      cuando: '',
      aprendizaje: '',
      contribucion: ''
    }
  ];

  constructor() {
    this.cargarProgreso();
  }

  guardarProgreso(): void {
    try {
      localStorage.setItem(
        this.claveGuardado,
        JSON.stringify(this.ejercicios)
      );

      this.guardado = true;
      this.mensaje = 'Tu reflexión se ha guardado en este navegador.';
    } catch {
      this.guardado = false;
      this.mensaje =
        'No fue posible guardar los cambios. Comprueba el almacenamiento del navegador.';
    }
  }

  private cargarProgreso(): void {
    try {
      const contenido = localStorage.getItem(this.claveGuardado);

      if (!contenido) {
        return;
      }

      const datos: unknown = JSON.parse(contenido);

      if (!Array.isArray(datos)) {
        return;
      }

      this.ejercicios = this.ejercicios.map((ejercicio) => {
        const guardado = datos.find(
          (item: any) => item?.id === ejercicio.id
        );

        if (!guardado) {
          return ejercicio;
        }

        return {
          ...ejercicio,
          accion: typeof guardado.accion === 'string'
            ? guardado.accion : '',
          cuando: typeof guardado.cuando === 'string'
            ? guardado.cuando : '',
          aprendizaje: typeof guardado.aprendizaje === 'string'
            ? guardado.aprendizaje : '',
          contribucion: typeof guardado.contribucion === 'string'
            ? guardado.contribucion : ''
        };
      });
    } catch {
      this.mensaje = 'No se pudo recuperar el progreso guardado.';
    }
  }
}
